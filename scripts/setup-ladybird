#!/usr/bin/env bash
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
local_root="$root/.local/engines/ladybird"
pin=$(cat "$root/engines/ladybird/REVISION")
sha=a0537c5d7662b415d257f0be271d310cc55ad80136bce0ede1387a686951da3b
mkdir -p "$local_root"
archive="$local_root/$pin.tar.gz"
if [[ ! -f "$archive" ]]; then
 curl --fail --location --retry 3 "https://codeload.github.com/LadybirdBrowser/ladybird/tar.gz/$pin" -o "$archive.part"
 mv "$archive.part" "$archive"
fi
printf '%s  %s\n' "$sha" "$archive" | sha256sum -c -
source_dir="$local_root/ladybird-$pin"
if [[ ! -d "$source_dir" ]]; then tar -xzf "$archive" -C "$local_root"; fi
# Compare every source byte with a fresh extraction; do not silently accept patches.
verify_dir=$(mktemp -d "$local_root/verify.XXXXXX")
trap 'rm -rf "$verify_dir"' EXIT
tar -xzf "$archive" -C "$verify_dir"
# Upstream reads REVISION for tarball builds that have no Git metadata.
cp "$root/engines/ladybird/REVISION" "$verify_dir/ladybird-$pin/REVISION"
if [[ ! -e "$source_dir/REVISION" ]]; then cp "$verify_dir/ladybird-$pin/REVISION" "$source_dir/REVISION"; fi
diff -qr "$verify_dir/ladybird-$pin" "$source_dir"
printf '{"repository":"https://github.com/LadybirdBrowser/ladybird","commit":"%s","archiveSha256":"%s","sourceVerified":true}\n' "$pin" "$sha" > "$local_root/provenance.json"
printf 'Verified pristine upstream: %s\n' "$source_dir"
if [[ ${1:-} != --build ]]; then exit 0; fi
vcpkg_dir="$local_root/vcpkg"
baseline=8f363bdc11359ede4bc51e5eb32a2617538049c8
if [[ ! -d "$vcpkg_dir/.git" ]]; then git clone https://github.com/microsoft/vcpkg.git "$vcpkg_dir"; fi
git -C "$vcpkg_dir" cat-file -e "$baseline^{commit}" || git -C "$vcpkg_dir" fetch origin "$baseline"
git -C "$vcpkg_dir" checkout "$baseline"
"$vcpkg_dir/bootstrap-vcpkg.sh" -disableMetrics
export VCPKG_MAX_CONCURRENCY=${LADYBIRD_JOBS:-4} CMAKE_BUILD_PARALLEL_LEVEL=${LADYBIRD_JOBS:-4}
export VCPKG_DISABLE_METRICS=1 VCPKG_FORCE_SYSTEM_BINARIES=1 PYTHONDONTWRITEBYTECODE=1
export VCPKG_BINARY_SOURCES="clear;files,$local_root/binary-cache,readwrite"
mkdir -p "$local_root/binary-cache"
export RUSTUP_TOOLCHAIN=1.98.0
build_dir="$local_root/build-$pin"
cmake -S "$source_dir" -B "$build_dir" -G Ninja \
 -DCMAKE_BUILD_TYPE=Release -DLADYBIRD_ENABLE_LTO=OFF -DBUILD_SHARED_LIBS=ON -DBUILD_TESTING=OFF \
 -DCMAKE_PROJECT_INCLUDE="$root/engines/ladybird/inject.cmake" -DCMAKE_C_COMPILER="${CC:-cc}" \
 -DCMAKE_CXX_COMPILER="${CXX:-c++}" \
 -DCMAKE_TOOLCHAIN_FILE="$vcpkg_dir/scripts/buildsystems/vcpkg.cmake" \
 -DLADYBIRD_CACHE_DIR="$local_root/caches" -DVCPKG_TARGET_TRIPLET=x64-linux-dynamic \
 -DVCPKG_OVERLAY_TRIPLETS="$source_dir/Meta/CMake/vcpkg/release-triplets" \
 2>&1 | tee "$local_root/configure-upstream.log"
cmake --build "$build_dir" --target ladybird derp-ladybird \
 2>&1 | tee "$local_root/build-upstream.log"
# Keep the previous engine usable until the replacement has finished building.
if [[ -d "$local_root/build-upstream" && ! -L "$local_root/build-upstream" ]]; then
 mv "$local_root/build-upstream" "$(mktemp -d "$local_root/previous.XXXXXX")/build-upstream"
fi
ln -sfnT "$build_dir" "$local_root/build-upstream"
