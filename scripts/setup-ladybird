#!/usr/bin/env bash
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
local_root="$root/.local/engines/ladybird"
pin=197c851802f23cf956800d8dfe5083e18a424490
sha=8016ade99c0cc7890da3ca3243a99ce7040930a6664e5228c0522f5363b4ab24
mkdir -p "$local_root"
archive="$local_root/upstream.tar.gz"
if [[ ! -f "$archive" ]]; then
 curl --fail --location --retry 3 "https://codeload.github.com/LadybirdBrowser/ladybird/tar.gz/$pin" -o "$archive.part"
 mv "$archive.part" "$archive"
fi
printf '%s  %s\n' "$sha" "$archive" | sha256sum -c -
source_dir="$local_root/ladybird-$pin"
if [[ ! -d "$source_dir" ]]; then tar -xzf "$archive" -C "$local_root"; fi
# Compare every source byte with a fresh extraction; do not silently accept patches.
verify_dir=$(mktemp -d "$local_root/verify.XXXXXX")
trap 'rm -rf "$verify_dir"' EXIT
tar -xzf "$archive" -C "$verify_dir"
diff -qr "$verify_dir/ladybird-$pin" "$source_dir"
printf '{"repository":"https://github.com/LadybirdBrowser/ladybird","commit":"%s","archiveSha256":"%s","sourceVerified":true}\n' "$pin" "$sha" > "$local_root/provenance.json"
printf 'Verified pristine upstream: %s\n' "$source_dir"
if [[ ${1:-} != --build ]]; then exit 0; fi
vcpkg_dir="$local_root/vcpkg"
baseline=2fa7118fb2ce0c27ab73e08ab1991f4cb67af880
if [[ ! -d "$vcpkg_dir/.git" ]]; then git clone https://github.com/microsoft/vcpkg.git "$vcpkg_dir"; fi
git -C "$vcpkg_dir" checkout "$baseline"
"$vcpkg_dir/bootstrap-vcpkg.sh" -disableMetrics
export VCPKG_MAX_CONCURRENCY=${LADYBIRD_JOBS:-4} CMAKE_BUILD_PARALLEL_LEVEL=${LADYBIRD_JOBS:-4}
export VCPKG_DISABLE_METRICS=1 VCPKG_FORCE_SYSTEM_BINARIES=1 PYTHONDONTWRITEBYTECODE=1
export VCPKG_BINARY_SOURCES="clear;files,$local_root/binary-cache,readwrite"
mkdir -p "$local_root/binary-cache"
cmake -S "$source_dir" -B "$local_root/build-upstream" -G Ninja \
 -DCMAKE_BUILD_TYPE=Release -DENABLE_LTO_FOR_RELEASE=OFF -DBUILD_SHARED_LIBS=OFF -DBUILD_TESTING=OFF \
 -DENABLE_QT=ON -DCMAKE_C_COMPILER="${CC:-/usr/lib/llvm19/bin/clang}" \
 -DCMAKE_CXX_COMPILER="${CXX:-/usr/lib/llvm19/bin/clang++}" \
 -DCMAKE_TOOLCHAIN_FILE="$vcpkg_dir/scripts/buildsystems/vcpkg.cmake" \
 -DVCPKG_OVERLAY_TRIPLETS="$source_dir/Meta/CMake/vcpkg/distribution-triplets" \
 2>&1 | tee "$local_root/configure-upstream.log"
cmake --build "$local_root/build-upstream" --target LibWebView ladybird WebContent RequestServer ImageDecoder \
 2>&1 | tee "$local_root/build-upstream.log"
