#!/usr/bin/env python3
import json, os, pathlib, subprocess, tempfile
root = pathlib.Path(__file__).resolve().parents[2]
binary = root / '.local/engines/ladybird/build-upstream/bin/derp-ladybird'
def run(requests):
    with tempfile.TemporaryDirectory() as directory:
        p = subprocess.run([str(binary)], input=''.join(json.dumps(r)+'\n' for r in requests), text=True, capture_output=True, timeout=20, check=True, env={**os.environ, 'DERP_FRAME_DIR':directory,'FONTCONFIG_FILE':str(root/'tests/ladybird/fonts.conf')})
    return [json.loads(line) for line in p.stdout.splitlines()]
r = run([{'id': 1, 'method': 'engine.status'}, {'id': 2, 'method': 'pane.create'}])
assert r[0]['result']['engineVersion'] == '197c851802f23cf956800d8dfe5083e18a424490'
assert {'frames','input','inspection','capture','readiness','resize'} <= set(r[0]['result']['capabilities'])
assert r[0]['result']['rendering'] is True
assert 'error' in r[1]
assert run([{'id': 3, 'method': 'session.close'}]) == [{'id': 3, 'result': {}}]
assert run([]) == []
print('Status provenance, capabilities, unknown pane rejection, close and EOF passed')
